{
  "name": "site-clone",
  "version": "1.0.0",
  "description": "CLI tool to clone websites into static sites or Next.js projects",
  "type": "module",
  "bin": {
    "site-clone": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean --outDir dist",
    "dev": "tsx src/cli.ts",
    "preview": "tsx src/cli.ts preview",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium"
  },
  "keywords": [
    "website-clone",
    "scraper",
    "static-site",
    "nextjs",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "css-tree": "^3.1.0",
    "fs-extra": "^11.3.0",
    "ora": "^8.2.0",
    "playwright": "^1.51.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.10",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
